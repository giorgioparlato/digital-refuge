<?xml version="1.0" encoding="utf-8"?>
<!-- The full-screen takeover shown while blocking is switched off mid-session. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ic_launcher_background"
    tools:ignore="HardcodedText,Overdraw"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="36dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_tile"
        android:tint="@color/ic_launcher_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="blocking is off"
        android:textColor="@color/widget_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/takeover_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="your session is still running. switch blocking back on to carry on."
        android:textColor="@color/widget_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/takeover_enable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="@drawable/takeover_primary"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="switch blocking back on"
        android:textColor="#FFF8F5F1"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/takeover_snooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:text="take a break"
        android:textColor="@color/widget_muted"
        android:textSize="15sp" />
</LinearLayout>
